# ============================================================
# STREAMVAULT — Variables de entorno
# ============================================================
# Copia este archivo como .env y llena con tus claves de Supabase
# Las encuentras en: Supabase Dashboard > Project Settings > API

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Correo del administrador (solo este correo tendrá rol admin)
VITE_ADMIN_EMAIL=

# ── Bot de códigos (StreamPanel) · SOLO en Vercel, nunca con prefijo VITE_ ──
# Service role key de Supabase (Project Settings > API). Es secreta: solo la usa /api/codebot.
SUPABASE_SERVICE_ROLE_KEY=
# URL del backend de StreamPanel, terminando en /api
STREAMPANEL_API_URL=
